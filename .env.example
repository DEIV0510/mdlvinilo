# Copia este archivo como .env.local y completa los valores reales.
# Ninguno es secreto: ambos se incluyen en el código del navegador.

# Dominio definitivo, sin barra final (activa canonical, sitemap y URLs absolutas)
NEXT_PUBLIC_SITE_URL=

# Solo si cambia el WhatsApp comercial (el oficial ya está en config/sitio.ts).
# Formato internacional, solo dígitos (Colombia: 57 + número)
NEXT_PUBLIC_WHATSAPP=

# Solo para revisar el diseño: 1 muestra el contenido de ejemplo en una compilación de producción
# MDL_DEMO=1

# Solo servidor propio: cabecera con la IP real del visitante fijada por tu proxy inverso
# (p. ej. Nginx: proxy_set_header X-Real-IP $remote_addr;). Activa el pase de buscadores verificados.
# MDL_CABECERA_IP=x-real-ip
