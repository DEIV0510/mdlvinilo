# Copia este archivo como .env.local y completa los valores reales.
# Ninguno es secreto: ambos se incluyen en el código del navegador.

# Dominio definitivo, sin barra final (activa canonical, sitemap y URLs absolutas)
NEXT_PUBLIC_SITE_URL=

# WhatsApp comercial en formato internacional, solo dígitos (Colombia: 57 + número)
NEXT_PUBLIC_WHATSAPP=

# Solo para revisar el diseño: 1 muestra el contenido de ejemplo en una compilación de producción
# MDL_DEMO=1
